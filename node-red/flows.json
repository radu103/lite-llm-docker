    {
        "id": "ce88b54e580b7a18",
        "type": "function",
        "z": "39e13ee1d7a019f5",
        "name": "process with docling",
        "func": "let fileName = msg.payload;\n\nconst directory = path.dirname(fileName);\nconst filename = path.basename(fileName);\n\nlet formData = {\n  \"files\": fs.createReadStream(fileName),\n  \"do_ocr\" : \"true\",\n  \"force_ocr\": \"true\",\n  \"ocr_engine\": 'easyocr',\n  \"image_export_mode\": 'referenced',\n  \"ocr_lang\": 'ro'\n}\n\nrequest.post({\n    url:'http://172.101.0.7:5001/v1alpha/convert/file',\n    timeout: 300000,\n    formData: formData\n}, \n  function(err, httpResponse, body) {\n    if (err) {\n      console.log('Upload failed:', err);\n      msg.payload = err;\n      return msg;\n    }\n\n    let bodyJson = JSON.parse(body);\n    bodyJson.document.md_content = body;\n    \n    let document = bodyJson.document;\n    document.body = body;\n\n    console.log(\"File : \" + directory + \"/\" + filename);\n    console.log(\"Processing time : \" + bodyJson.processing_time + \" seconds\");\n\n    document.filedir = directory;\n    document.file = filename;\n    msg.payload = document;\n    \n    //console.log(msg);\n    return msg;\n});",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "FormData",
                "module": "form-data"
            },
            {
                "var": "fs",
                "module": "fs"
            },
            {
                "var": "request",
                "module": "request"
            },
            {
                "var": "path",
                "module": "path"
            }
        ],
        "x": 720,
        "y": 280,
        "wires": [
            [
                "2bdb0f409a88fcc3"
            ]
        ]
    },
