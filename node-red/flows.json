    {
        "id": "d84f2393a349126e",
        "type": "function",
        "z": "39e13ee1d7a019f5",
        "name": "doc file extensions",
        "func": "if(msg.payload.includes('.pdf'))\n    return msg;\nelse if(msg.payload.includes('.docx'))\n    return msg;\nelse if(msg.payload.includes('.pptx'))\n    return msg;\nelse if(msg.payload.includes('.txt'))\n    return msg;\nelse if(msg.payload.includes('.md'))\n    return msg;\nelse if(msg.payload.includes('.html'))\n    return msg;\nelse if(msg.payload.includes('.bmp'))\n    return msg;\nelse if(msg.payload.includes('.jpg'))\n    return msg;\nelse if(msg.payload.includes('.jpeg'))\n    return msg;\nelse if(msg.payload.includes('.png'))\n    return msg;\nelse if(msg.payload.includes('.tiff'))\n    return msg;\nelse if(msg.payload.includes('.bmp'))\n    return msg;     \n\nconsole.log(\"Invalid file extension\");\nreturn '';",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 280,
        "wires": [
