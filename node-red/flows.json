    {
        "id": "ce88b54e580b7a18",
        "type": "function",
        "z": "39e13ee1d7a019f5",
        "name": "process with docling",
        "func": "let fileName = msg.payload;\nconsole.log(fileName);\n\nlet formData = {\n  \"files\": fs.createReadStream(fileName),\n  \"do_ocr\" : \"true\",\n  \"force_ocr\": \"true\",\n  \"ocr_engine\": 'easyocr',\n  \"image_export_mode\": 'referenced',\n  \"ocr_lang\": 'ro'\n}\n\nrequest.post({\n    url:'http://172.101.0.7:5001/v1alpha/convert/file',\n    timeout: 300000,\n    formData: formData\n}, \n  function(err, httpResponse, body) {\n  if (err) {\n    console.error('Upload failed:', err);\n    msg.payload = err;\n    return msg;\n  }\n  msg.payload = JSON.parse(body);\n  return msg;\n});",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "FormData",
                "module": "form-data"
            },
